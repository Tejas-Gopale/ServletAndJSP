<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee"
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="https://jakarta.ee 
                             https://jakarta.ee/web-app_6_0.xsd"
         version="6.0">
         
    <display-name>Servlet_Demo_Project</display-name>
    
    <servlet>
    	<servlet-name>add2Number</servlet-name>
    	<servlet-class>com.tejas.AddServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
	    <servlet-name>add2Number</servlet-name>
	    <url-pattern>/add</url-pattern>
    </servlet-mapping>
    
    
    <servlet>
    	<servlet-name>sq</servlet-name>
    	<servlet-class>com.tejas.SquareServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
	    <servlet-name>sq</servlet-name>
	    <url-pattern>/sq</url-pattern>
    </servlet-mapping>
</web-app>
